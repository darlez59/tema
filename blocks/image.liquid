{% liquid
  assign block_st = block.settings
%}
{% if block_st.image_block != blank %}
  <style>
    [data-block-id="{{ block.id }}"] > div {
      height: {{ block_st.banner_height }}px;
      overflow: hidden;
    }
    [data-block-id="{{ block.id }}"] img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
  </style>
  <div class="w-full flex md-justify-{{ section.settings.content_alignment }} mb-justify-{{ section.settings.content_alignment_mobile }}" data-block-id="{{ block.id }}">
    <div
      class="sec__content-img block w-custom mb-custom"
      style="--custom-width: 100%; --space-bottom: {{ block_st.spacing_bottom }};"
    >
      {%- assign sizes = '100vw' -%}
      {%- assign image_alt = block_st.image_block.alt | default: '' -%}

      {% render 'responsive-image',
        type: 'banner',
        image: block_st.image_block,
        image_alt: image_alt,
        sizes: sizes,
        width: block_st.image_width,
        no_animate: true
      %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:sections.all.image.label",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_block",
      "label": "t:sections.all.image.label"
    },
    {
      "type": "range",
      "id": "banner_height",
      "min": 100,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Alto del banner",
      "default": 500
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 480,
      "max": 3840,
      "step": 10,
      "unit": "px",
      "label": "t:sections.footer.blocks.store_info.settings.image_width",
      "default": 1920
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "t:sections.all.content_settings.spacing.spacing_bottom.label",
      "default": 30,
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:sections.all.image.label",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
